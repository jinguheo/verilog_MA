[options]
# Checker sanity: MUT_CNT_WRAP alone (carry out discarded, counter wraps
# instead of saturating). Expected outcome: FAIL, not PASS.
mode prove
depth 20

[engines]
smtbmc

[script]
plugin -i slang
read_slang --top cnt_sat_formal -DMUT_CNT_WRAP cnt_sat_MUTANT.sv cnt_sat_formal.sv
prep -top cnt_sat_formal

[files]
mutants/cnt_sat_MUTANT.sv
formal/cnt_sat_formal.sv
