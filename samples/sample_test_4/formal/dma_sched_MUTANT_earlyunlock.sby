[options]
# Checker sanity: MUT_SCHED_EARLYUNLOCK alone (unlock triggers on eop being
# offered, not accepted). Expected: FAIL, not PASS.
mode prove
depth 20

[engines]
smtbmc

[script]
plugin -i slang
read_slang --top dma_sched_formal -DDAQ_NUM_CH=2 -DMUT_SCHED_EARLYUNLOCK prim_util_pkg.sv prim_assert.sv prim_leading_one_ppc.sv prim_arbiter_ppc.sv prim_arbiter_tree.sv axi_pkg.sv daq_pkg.sv dma_sched_MUTANT.sv dma_sched_formal.sv
prep -top dma_sched_formal

[files]
