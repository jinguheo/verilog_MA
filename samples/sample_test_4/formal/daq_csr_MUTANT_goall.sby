[options]
# Checker sanity: MUT_CSR_GOALL alone (CH_DESC_CTRL's go pulse fires on
# every channel instead of only the addressed one). Expected: FAIL, not PASS.
mode prove
depth 20

[engines]
smtbmc

[script]
plugin -i slang
read_slang --top daq_csr_formal -DDAQ_NUM_CH=2 -DMUT_CSR_GOALL axi_pkg.sv daq_pkg.sv daq_csr_MUTANT.sv daq_csr_formal.sv
prep -top daq_csr_formal

[files]
rtl/pkg/axi_pkg.sv
rtl/pkg/daq_pkg.sv
mutants/daq_csr_MUTANT.sv
formal/daq_csr_formal.sv
